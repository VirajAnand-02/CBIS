# Face Detection Service Configuration

# Next.js API URL (localhost for non-Docker deployment)
NEXTJS_API_URL=http://localhost:3000

# Face detection model
FACE_DETECTION_MODEL=retinaface

# Face recognition model (ArcFace)
FACE_RECOGNITION_MODEL=arcface_r100_v1

# Detection thresholds
MIN_FACE_SIZE=40
MIN_CONFIDENCE=0.6

# Recognition threshold (cosine distance)
# Lower = more strict matching
# 0.3 = very strict (same person, different angles)
# 0.4 = recommended (same person, different lighting/time)
# 0.55 = lenient (same person across varying conditions)
# 0.6+ = very loose (may have false positives)
RECOGNITION_THRESHOLD=0.55

# Queue configuration
MAX_QUEUE_SIZE=1000

# GPU configuration (optional)
# CUDA_VISIBLE_DEVICES=0
