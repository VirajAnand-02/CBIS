# Dockerfile.gpu.alt (keeps CUDA 12.9 base - use only if you have matching TF wheel)
FROM nvidia/cuda:12.9.0-runtime-ubuntu24.04

WORKDIR /app
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip \
    build-essential ca-certificates wget git \
    libgl1 libglib2.0-0 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --break-system-packages --upgrade pip setuptools wheel || true

COPY requirements.txt /app/requirements.txt
COPY app.py /app/app.py
COPY mobilenet_nima.h5 /app/mobilenet_nima.h5

RUN set -eux; \
    pip install --break-system-packages --no-cache-dir -r /app/requirements.txt

EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD python3 -c "import requests,sys; r = requests.get('http://localhost:8002/'); sys.exit(0 if r.status_code==200 else 1)" || exit 1

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8002"]

# docker build -f Dockerfile.gpu -t nima-gpu .
# docker run --gpus all -p 8002:8002 nima-gpu
