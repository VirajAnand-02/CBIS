// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  extensions = [vector]
}

// ============================================================
// CBIS Project Schema - Content-Based Image Search
// ============================================================

/// Main blob storage metadata table
/// Stores metadata about uploaded images/documents
model Blob {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // File information
  filename    String
  originalName String?
  mimeType    String
  size        Int      // in bytes
  width       Int?
  height      Int?
  
  // Storage information
  storagePath String   // relative path in storage/blobs/
  thumbnailPath String? // path to thumbnail if generated
  
  // Upload metadata
  uploadedBy  String?  // user identifier if auth is implemented
  uploadedFrom String? // IP or device info
  
  // Processing status
  processingStatus String @default("pending") // pending, processing, completed, failed
  processingError String?
  
  // Relations
  embeddings  Embedding[]
  attributes  BlobAttribute?
  ocrResults  OCRResult[]
  
  @@index([createdAt])
  @@index([processingStatus])
  @@index([mimeType])
  @@map("blobs")
}

/// CLIP embeddings for semantic search
/// Supports vector similarity search using pgvector extension
model Embedding {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  
  // Relation to blob
  blobId    String
  blob      Blob     @relation(fields: [blobId], references: [id], onDelete: Cascade)
  
  // Vector embedding (512 dimensions for CLIP)
  // Using Unsupported type for pgvector
  vector    Unsupported("vector(512)")
  
  // Caption generated by BLIP
  caption   String?  @db.Text
  
  // Model information
  modelName String   @default("openai/clip-vit-base-patch32")
  modelVersion String?
  
  // Processing time tracking
  embeddingTime Float? // seconds
  captionTime   Float? // seconds
  device        String? // cuda or cpu
  
  @@unique([blobId])
  @@index([blobId])
  @@map("embeddings")
}

/// Image type classification and attributes
/// Results from Type Router service
model BlobAttribute {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relation to blob
  blobId    String   @unique
  blob      Blob     @relation(fields: [blobId], references: [id], onDelete: Cascade)
  
  // Classification results (boolean)
  isDocument   Boolean @default(false)
  hasPeople    Boolean @default(false)
  isScreenshot Boolean @default(false)
  isAnimal     Boolean @default(false)
  
  // Confidence scores (0-1)
  documentProb   Float @default(0.0)
  peopleProb     Float @default(0.0)
  screenshotProb Float @default(0.0)
  animalProb     Float @default(0.0)
  
  // NIMA aesthetic score
  nimaScore      Float? // overall aesthetic score
  nimaTechnical  Float? // technical quality
  nimaAesthetic  Float? // aesthetic quality
  nimaDistribution Json? // full score distribution
  
  // Model information
  routerModel String @default("type_router_v1")
  nimaModel   String?
  
  @@index([isDocument])
  @@index([hasPeople])
  @@index([isScreenshot])
  @@index([isAnimal])
  @@index([nimaScore])
  @@map("blob_attributes")
}

/// OCR (Optical Character Recognition) results
/// Extracted text from documents and images
model OCRResult {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  
  // Relation to blob
  blobId    String
  blob      Blob     @relation(fields: [blobId], references: [id], onDelete: Cascade)
  
  // Extracted text (can be very long)
  text      String   @db.Text
  
  // OCR metadata
  language  String?  // detected language
  confidence Float?  // overall confidence score
  
  // Structured data if available
  structuredData Json? // bounding boxes, line info, etc.
  
  // OCR engine information
  engine    String   @default("paddleocr") // paddleocr, tesseract, etc.
  engineVersion String?
  
  // Processing time
  processingTime Float? // seconds
  
  @@index([blobId])
  @@map("ocr_results")
}

/// Search history and analytics
/// Track user searches for insights and improvements
model SearchQuery {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  
  // Query information
  queryText String   @db.Text
  queryType String   // text, image, hybrid
  
  // Search parameters
  filters   Json?    // applied filters
  limit     Int      @default(20)
  
  // Results
  resultCount Int    @default(0)
  results     Json?  // array of blob IDs
  
  // Performance metrics
  searchTime Float?  // seconds
  
  // User information
  userId    String?
  sessionId String?
  
  @@index([createdAt])
  @@index([queryType])
  @@map("search_queries")
}

/// Collections - user-created groups of blobs
/// For organizing and categorizing content
model Collection {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Collection information
  name        String
  description String?  @db.Text
  color       String?  // hex color for UI
  icon        String?  // icon identifier
  
  // Ownership
  createdBy   String?
  isPublic    Boolean  @default(false)
  
  // Relations
  items       CollectionItem[]
  
  @@index([createdBy])
  @@index([createdAt])
  @@map("collections")
}

/// Junction table for many-to-many relationship
/// between Collections and Blobs
model CollectionItem {
  id           String     @id @default(uuid())
  createdAt    DateTime   @default(now())
  
  // Relations
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  
  blobId       String
  // Note: Can't create relation to Blob here without adding items field to Blob model
  
  // Ordering
  order        Int        @default(0)
  notes        String?    @db.Text
  
  @@unique([collectionId, blobId])
  @@index([collectionId])
  @@index([blobId])
  @@map("collection_items")
}

/// Processing jobs queue
/// Track background processing tasks
model ProcessingJob {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  startedAt   DateTime?
  completedAt DateTime?
  
  // Job information
  jobType     String   // embedding, ocr, type_router, nima, thumbnail
  status      String   @default("pending") // pending, running, completed, failed
  priority    Int      @default(5) // 1-10, higher = more important
  
  // Target
  blobId      String
  
  // Results and errors
  result      Json?
  error       String?  @db.Text
  retryCount  Int      @default(0)
  maxRetries  Int      @default(3)
  
  // Performance
  processingTime Float? // seconds
  
  @@index([status])
  @@index([jobType])
  @@index([blobId])
  @@index([createdAt])
  @@map("processing_jobs")
}

